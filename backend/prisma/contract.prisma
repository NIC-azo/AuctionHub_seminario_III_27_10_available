// use prisma-8

model User {
  id        String    @id @onCreate(uuid())
  username  String    @unique
  email     String    @unique
  password  String
  role      String    @default("buyer")
  createdAt DateTime  @default(now())

  products  Product[] @relation("SellerProducts")
  purchases Product[] @relation("WinnerProducts")
  bids      Bid[]     @relation("UserBids")
}

model Product {
  id           String   @id @onCreate(uuid())
  title        String
  description  String
  initialPrice Float
  currentPrice Float
  imageUrl     String
  status       String   @default("available")

  sellerId String
  seller   User   @relation("SellerProducts", fields: [sellerId], references: [id])

  winnerId String?
  winner   User?   @relation("WinnerProducts", fields: [winnerId], references: [id])

  bids     Bid[]  @relation("ProductBids")

  createdAt DateTime @default(now())

  @@index([sellerId])
  @@index([winnerId])
}

model Bid {
  id        String   @id @onCreate(uuid())
  amount    Float
  productId String
  userId    String
  createdAt DateTime @default(now())

  product Product @relation("ProductBids", fields: [productId], references: [id])
  user    User    @relation("UserBids", fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
}
